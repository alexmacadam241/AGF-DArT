test_CH_T0_AR <- perm_region_test(AR_perm, "Central", "Hybrid")
test_CH_T0_AR <- perm_region_test(AR_perm, "Central", "Hybrid")
test_CN_T0_AR <- perm_region_test(AR_perm, "Central", "North")
test_NH_T0_AR <- perm_region_test(AR_perm, "North", "Hybrid")
perm_results_T0_AR <- dplyr::bind_rows(test_CH_T0_AR, test_CN_T0_AR, test_NH_T0_AR)
#AR
AR_perm<- long_diversity_Amb|> filter(Metric == "Allelic Richness")
test_CH_Amb_AR <- perm_region_test(AR_perm, "Central", "Hybrid")
test_CH_Amb_AR <- perm_region_test(AR_perm, "Central", "Hybrid")
test_CN_Amb_AR <- perm_region_test(AR_perm, "Central", "North")
test_NH_Amb_AR <- perm_region_test(AR_perm, "North", "Hybrid")
test_NH_Amb_AR <- perm_region_test(AR_perm, "North", "Hybrid")
perm_results_Amb_AR <- dplyr::bind_rows(test_CH_Amb_AR, test_CN_Amb_AR, test_NH_Amb_AR)
#AR
AR_perm<- long_diversity_Hot|> filter(Metric == "Allelic Richness")
test_CN_Hot_AR <- perm_region_test(AR_perm, "Central", "North")
test_CN_Hot_AR <- perm_region_test(AR_perm, "Central", "North")
test_NH_Hot_AR <- perm_region_test(AR_perm, "North", "Hybrid")
perm_results_Hot_AR <- dplyr::bind_rows(test_CH_Hot_AR, test_CN_Hot_AR, test_NH_Hot_AR)
#pemutation test
perm_region_test <- function(data, regionA, regionB, metric="Shannon Index", nperm=9999) {
# Extract only the metric you are testing
dat <- data %>%
filter(Metric == metric, Region %in% c(regionA, regionB)) %>%
select(Iteration2, Region, Value)
# Reshape wide to pair values within iteration
paired <- dat %>%
tidyr::pivot_wider(names_from = Region, values_from = Value)
# Convert to numeric to avoid subtraction errors
paired[[regionA]] <- as.numeric(paired[[regionA]])
paired[[regionB]] <- as.numeric(paired[[regionB]])
# Observed difference in means
obs_diff <- mean(paired[[regionA]] - paired[[regionB]])
# Permutation null distribution
null_dist <- numeric(nperm)
set.seed(123)
for (i in 1:nperm) {
shuffled <- paired
flip <- sample(c(TRUE, FALSE), nrow(paired), replace = TRUE)
shuffled[[regionA]][flip] <- paired[[regionB]][flip]
shuffled[[regionB]][flip] <- paired[[regionA]][flip]
null_dist[i] <- mean(shuffled[[regionA]] - shuffled[[regionB]])
}
# Two-sided p-value
p_val <- mean(abs(null_dist) >= abs(obs_diff))
return(list(
regionA = regionA,
regionB = regionB,
obs_diff = obs_diff,
p_value = p_val
))
}
#SI
