test_CH_T0_SI <- perm_region_test(SI_perm, "Central", "Hybrid")
test_CH_T0_SI <- perm_region_test(SI_perm, "Central", "Hybrid")
test_CN_T0_SI <- perm_region_test(SI_perm, "Central", "North")
test_NH_T0_SI <- perm_region_test(SI_perm, "North", "Hybrid")
