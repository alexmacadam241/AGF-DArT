#pemutation test
perm_region_test <- function(data, regionA, regionB, metric="Allelic Richness", nperm=9999) {
# Extract only the metric you are testing
dat <- data %>%
filter(Metric == metric, Region %in% c(regionA, regionB)) %>%
select(Iteration2, Region, Value)
# Reshape wide to pair values within iteration
paired <- dat %>%
tidyr::pivot_wider(names_from = Region, values_from = Value)
# Convert to numeric to avoid subtraction errors
paired[[regionA]] <- as.numeric(paired[[regionA]])
paired[[regionB]] <- as.numeric(paired[[regionB]])
# Observed difference in means
obs_diff <- mean(paired[[regionA]] - paired[[regionB]])
# Permutation null distribution
null_dist <- numeric(nperm)
set.seed(123)
for (i in 1:nperm) {
shuffled <- paired
flip <- sample(c(TRUE, FALSE), nrow(paired), replace = TRUE)
shuffled[[regionA]][flip] <- paired[[regionB]][flip]
shuffled[[regionB]][flip] <- paired[[regionA]][flip]
null_dist[i] <- mean(shuffled[[regionA]] - shuffled[[regionB]])
}
# Two-sided p-value
p_val <- mean(abs(null_dist) >= abs(obs_diff))
return(list(
regionA = regionA,
regionB = regionB,
obs_diff = obs_diff,
p_value = p_val
))
}
#AR
