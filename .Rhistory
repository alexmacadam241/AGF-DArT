dist
set.seed(123) #reproducible results
bird.div<-adonis2(dist~as.factor(Temp) * as.factor(regioncross), data=div2, permutations=9999)
bird.div
birdMDS<-metaMDS(matrix2, distance="bray", k=2, trymax=35, autotransform=TRUE) ##k is the number of dimensions
stressplot(birdMDS)
NMDS1<-birdMDS$points[,1]
NMDS2<-birdMDS$points[,2]
