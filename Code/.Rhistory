#fit_larv %>% SUYR_prior_and_posterior()
fit_larv$fit |> stan_trace()
fit_larv$fit |> stan_ac()
fit_larv$fit |> stan_rhat()
fit_larv$fit |> stan_ess()
fit_larv |> pp_check(type = 'dens_overlay', nsamples = 250)
