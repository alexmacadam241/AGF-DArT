juv_survival <- read.csv("/Users/alexmacadam/Dropbox/PhD/Chapter3_Genomics/Final analysis/Data/juv_surv2020.csv", header=T, fileEncoding="UTF-8-BOM")
#change catagorical columns to factors and remove NAs
