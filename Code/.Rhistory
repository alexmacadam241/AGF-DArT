ranef_summary_juv<- ranef_summary_juv |> mutate(lifestage = "juv")
ranef_summary <- rbind(ranef_summary_larv, ranef_summary_juv)
par_con_dam_box <- ranef_summary |> filter(group == "Dams") |>
ggplot() +
geom_boxplot(aes(x = Region, y = mean, fill = Region)) +
facet_wrap(~lifestage, drop = T) +
labs(y = "ICC") +
scale_color_manual(values=pal[c(1,5)]) +
scale_fill_manual(values = pal[c(1, 5)]) +
labs(x='Parent', y="ICC")+
theme_Publication() +
theme(legend.key.height = unit(0.3, "cm"),
legend.margin=margin(0,0,0,0),
legend.box.margin=margin(0,0,0,0),
plot.margin = margin(rep(0.5,4)),
legend.position="right",
legend.direction = "vertical",
axis.text.x = element_text(angle = 90),
axis.text.y = element_text(angle = 90),
strip.background = element_rect(fill = "white", color = "black")
) +
scale_y_continuous(limits = c(-2, 3),breaks = seq(-3, 3, 1))
par_con_dam_box
par_con_sire_box <- ranef_summary |> filter(group == "Sires") |>
ggplot() +
geom_boxplot(aes(x = Region, y = mean, fill = Region)) +
facet_wrap(~lifestage, drop = T) +
labs(y = "ICC") +
scale_color_manual(values=pal[c(1,5)]) +
scale_fill_manual(values = pal[c(1, 5)]) +
labs(x='Parent', y="ICC")+
theme_Publication() +
theme(legend.key.height = unit(0.3, "cm"),
legend.margin=margin(0,0,0,0),
legend.box.margin=margin(0,0,0,0),
plot.margin = margin(rep(0.5,4)),
legend.position="right",
legend.direction = "vertical",
axis.text.x = element_text(angle = 90),
axis.text.y = element_text(angle = 90),
strip.background = element_rect(fill = "white", color = "black")
) +
scale_y_continuous(limits = c(-2, 3),breaks = seq(-3, 3, 1))
par_con_sire_box
con_plot + par_con_sire_box + par_con_dam_box + plot_annotation(tag_levels = "A") + plot_layout(ncol = 3, guides = "collect", widths = c(3,1,1))
summary_summary <- summarySE(ranef_summary, measurevar="mean",
groupvars=c("lifestage","Region"), na.rm=TRUE)
