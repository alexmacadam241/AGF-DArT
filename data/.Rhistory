KOG_plot2<- ggplot(data = KOG, aes(x = delta.rank, y = reorder(term, delta.rank), color = padj, size = nseqs)) +
geom_point() +
scale_color_gradient(low = "red", high = "blue") +
labs(x = "Delta Rank", y = "KOG Term", color = "Adjusted P-value", size = "N Seqs") +
theme_minimal()
KOG_plot2
KOG_plot1<- ggplot(data = KOG, aes(x = reorder(term, nseqs), y = nseqs, fill = delta.rank)) +
geom_bar(stat = "identity") +
coord_flip() +
scale_fill_gradient(low = "red", high = "blue") +
facet_wrap(~ cut(padj, breaks = c(0, 0.05, 0.1, 1), labels = c("p <= 0.05", "0.05 < p <= 0.1", "p > 0.1"))) +
labs(x = "KOG Term", y = "Number of Sequences", fill = "Delta rank") +
theme_minimal()
KOG_plot1
KOG_plot2<- ggplot(data = KOG, aes(x = delta.rank, y = reorder(term, delta.rank), color = nseqs, size = nseqs)) +
geom_point() +
scale_color_gradient(low = "red", high = "blue") +
labs(x = "Delta Rank", y = "KOG Term", color = "N Seqs", size = "N Seqs") +
theme_minimal()
KOG_plot2
KOG_plot<- KOG_plot1 + KOG_plot2
KOG_corr<- ggplot(data = KOG, aes(x = delta.rank, y = reorder(term, delta.rank))) +
geom_bar(stat = "identity") +
scale_fill_gradient(low = "red", high = "blue") +
labs(x = "Delta Rank", y = "KOG Term") +
theme_Publication()
KOG_corr
sig_SNPs1<- sig_SNPs1 |> dplyr::rename(SNP = SNP2)
#read in sig genes
#find gene names for sig SNPs
sig_SNPs_GO<- sig_SNPs1 |> left_join(snps_flanking_gene_names_m1, by = "SNP") |>
dplyr::select(gene, r, p) |>
distinct(gene, .keep_all=TRUE) |>
as.data.frame() |>
mutate(gene = as.factor(gene)) |>
na.omit()
sig_SNPs_GO$p[is.na(sig_SNPs_GO$p)] <- 1
#extract gene names
genes<- gene2kog_aten |> dplyr::select(V1) |> dplyr::rename(gene=V1)
#join all gene names to significant genes
sig_genes2<- genes |> left_join(sig_SNPs_GO, by = "gene")
#add .m1 to gene names to correspond with other datasets
sig_genes2$gene <- paste0(sig_genes2$gene, ".m1")
#turn non-sig genes NAs to 0s
sig_genes2$r[is.na(sig_genes2$r)] <- 0
#select relevant columns
sig_genes3<- sig_genes2 |> dplyr::select(gene, r)
